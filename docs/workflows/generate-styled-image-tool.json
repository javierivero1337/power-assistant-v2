{
  "name": "generate_styled_image",
  "description": "Calls the Gemini Imagen webhook to stylize a WhatsApp photo.",
  "method": "POST",
  "url": "https://YOUR_DEPLOYMENT_URL/generate-styled-image",
  "headers": {
    "Content-Type": "application/json",
    "X-Kapso-Webhook-Secret": "{{secrets.kapsoWebhookSecret}}"
  },
  "requestSchema": {
    "type": "object",
    "required": ["imageUrl", "style", "userId"],
    "properties": {
      "imageUrl": {
        "type": "string",
        "description": "Signed WhatsApp media URL from get_whatsapp_context."
      },
      "style": {
        "type": "string",
        "enum": ["linkedin", "cartoon", "cinematic", "vintage", "artistic"]
      },
      "userId": {
        "type": "string",
        "description": "User's WhatsApp phone number (e.g., +15551234567) for credit tracking."
      },
      "aspectRatio": {
        "type": "string",
        "description": "Optional Imagen aspect ratio, e.g. 1:1"
      },
      "imageSize": {
        "type": "string",
        "description": "Optional width x height, e.g. 1024x1024"
      }
    },
    "additionalProperties": false
  },
  "responseSchema": {
    "type": "object",
    "required": ["stylizedImageUrl"],
    "properties": {
      "stylizedImageUrl": {
        "type": "string",
        "description": "Public URL of the stylized image."
      },
      "caption": {
        "type": "string",
        "description": "Optional WhatsApp caption to reuse."
      },
      "creditsRemaining": {
        "type": "number",
        "description": "Number of credits remaining after this generation."
      },
      "error": {
        "type": "string",
        "description": "Error message if generation failed (e.g., insufficient credits)."
      },
      "message": {
        "type": "string",
        "description": "Human-readable message about the error."
      },
      "paymentLink": {
        "type": "string",
        "description": "Stripe payment link if user needs to purchase credits."
      }
    },
    "additionalProperties": false
  }
}

